@prefix : <https://kgheartbeat.di.unisa.it/fairness-data/> .
@prefix fairo: <https://w3id.org/fair-o#> .
@prefix fairVocab: <https://w3id.org/fair/principles/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .

:ratioScoringFunction a fairo:ScoringFunction ;
    rdfs:label "Ratio Scoring Function" ;
    fairo:formula "Number of successful conditions / Total number of conditions" ;
    dct:description "A scoring function that calculates the ratio of successful conditions to the total number of conditions." ;
    fairo:minValue "0"^^xsd:decimal ;
    fairo:maxValue "1"^^xsd:decimal .

:binaryScoringFunction a fairo:ScoringFunction ;
    rdfs:label "Binary Scoring Function" ;
    fairo:formula "IF condition = 'Satisfied' THEN 1 ELSE 0" ;
    dct:description "A scoring function that assigns a score of 1 if the condition is satisfied and 0 otherwise." ;
    fairo:minValue "0"^^xsd:decimal ;
    fairo:maxValue "1"^^xsd:decimal .

:derefRatio a fairo:ScoringFunction ;
    rdfs:label "Dereferenceability Ratio" ;
    fairo:formula "Number of dereferenceable URIs / Total number of URIs" ;
    dct:description "The dereferencability value is calculated as the ratio of successfully dereferenced URIs to the total count of valid URIs." ;
    fairo:minValue "0"^^xsd:decimal ;
    fairo:maxValue "1"^^xsd:decimal .

:KGHeartBeat a prov:SoftwareAgent ;
    rdfs:label "KGHeartBeat" .

:algF1M a fairo:CalculationAlgorithm ;
    rdfs:label "F1-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "Checks whether the dataset, identified by its dataset identifier, is indexed in the Linked Open Data Cloud, DataHub or CHeCLOUD search engines. In parallel, it verifies the presence of a Digital Object Identifier (DOI) associated with the same dataset. If at least one of these two conditions holds—namely, the dataset is discoverable via the search engine or it is associated with a DOI." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algF1D a fairo:CalculationAlgorithm ;
    rdfs:label "F1-D" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "checks URI dereferencability by first attempting to retrieve 5000 random URIs from a SPARQL endpoint, validates each URI, and tries to fetch it with an HTTP GET request accepting RDF/XML with a 2-second timeout, counting successful responses with status code 200." ;
    fairo:appliesScoringFunction :derefRatio .

:algF2aM a fairo:CalculationAlgorithm ;
    rdfs:label "F2a-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "checks whether at least one access mechanism is provided for the dataset. It assigns a value of 1 to the SPARQL indication if a SPARQL endpoint URL is present, and a value of 1 to the VoID indication if a VoID URL is present; otherwise, both are set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algF2bM a fairo:CalculationAlgorithm ;
    rdfs:label "F2b-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "the arithmetic mean of nine binary indicators—SPARQL availability, DOI presence, data dump availability, verifiability information (checking if at least an author from metadata or query, the contributors, the publishers or source are available), media type specification, license declaration, vocabulary usage, presence of links, and VoID availability—and rounds the resulting value to two decimal places." ;
    fairo:appliesScoringFunction :ratioScoringFunction .

:algF3M a fairo:CalculationAlgorithm ;
    rdfs:label "F3-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "retrieves metadata for a given dataset identifier and attempts to obtain a DOI from three different sources: the LOD Cloud, Monitoring Resources, and CHeCloud. It first extracts the DOI from the LOD Cloud metadata, then queries Monitoring Resources and CHeCloud independently, logging the retrieved values. The algorithm returns the first DOI that is neither false nor null, following the priority order of LOD Cloud, Monitoring Resources, and CHeCloud; if no valid DOI is found from any source, it returns false." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algF4M a fairo:CalculationAlgorithm ;
    rdfs:label "F4-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "verifies if the dataset is indexed in at least one of the two search engines: LOD Cloud or DataHub." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algA11D a fairo:CalculationAlgorithm ;
    rdfs:label "A1.1-D" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "evaluates the accessibility of the dataset by checking the availability of a SPARQL endpoint and an RDF dump. If the SPARQL endpoint or a RDF dump is available and operative, a value of 1 is assigned. If one of it is only indicated but not operative, 0.5 is assigned. 0 if is either sparql endpoint and rdf dump are not indicated." .

:algA11M a fairo:CalculationAlgorithm ;
    rdfs:label "A1.1-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It first checks whether the dataset is listed on either of two search engines: DataHub or LOD Cloud. If the dataset is found on either platform (indicated by receiving valid dictionary metadata from their APIs), the accessibility score is set to 1. If not found on these search engines, the algorithm falls back to checking two alternative availability indicators: whether a SPARQL endpoint is available, or whether a VoID (Vocabulary of Interlinked Datasets) file is available. The accessibility score is set to 1 if at least one of these alternatives is available, otherwise it remains 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algA12 a fairo:CalculationAlgorithm ;
    rdfs:label "A1.2" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "calculates an accessibility sub-metric (a1_2) based on two security-related factors. First, it checks whether the dataset uses HTTPS or has an available SPARQL endpoint, assigning a score of 1 if either condition is true. Second, it checks the authentication requirement status, assigning a score of 1 if it can be detected as authntication needed or not needed." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algA2M a fairo:CalculationAlgorithm ;
    rdfs:label "A2-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "Checks if the dataset is available on DataHub or LOD Cloud search engines. Additionally, also check if it is on github, zenodo or faircharing" ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algI1D a fairo:CalculationAlgorithm ;
    rdfs:label "I1-D" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It first checks whether the dataset is listed on DataHub or LOD Cloud search engines. Then it evaluates two conditions: whether the dataset uses a common media type, and whether its metadata media type includes a known semantic format (specifically SPARQL API, or RDF in any case). The interoperability score is set to 1 if either the common media type flag is true or a recognized semantic format is found in the metadata, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algI1M a fairo:CalculationAlgorithm ;
    rdfs:label "I1-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It checks two sources for VoID (Vocabulary of Interlinked Datasets) availability: whether a VoID URL exists in the metadata, and whether a VoID or DCAT description can be retrieved by querying the SPARQL endpoint directly. The final interoperability score is set to 1 if a VoID description is available from either source, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algI2 a fairo:CalculationAlgorithm ;
    rdfs:label "I2" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It first checks whether the dataset has any vocabularies defined by verifying the vocabularies field in the metadata is not empty. If vocabularies are present, it evaluates whether those vocabularies comply with FAIR (Findable, Accessible, Interoperable, Reusable) principles (checking if it is registered in FAIRSharing catalogue) and assigns the result as the metric value. If no vocabularies are defined, the metric is set to 0." ;
    fairo:appliesScoringFunction :ratioScoringFunction .

:algI3D a fairo:CalculationAlgorithm ;
    rdfs:label "I3-D" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "If the dataset is available on a search engine, it checks whether the degree of connection to other datasets is greater than zero, setting the metric to 1 if true and 0 otherwise, with error handling for type conversion issues. If the dataset is not on a search engine, it alternatively checks for the presence of interlinking through two methods: owl:sameAs links or SKOS mapping relations. The metric is set to 1 if either of these interlinking indicators has a value greater than zero, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algR11 a fairo:CalculationAlgorithm ;
    rdfs:label "R1.1" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It evaluates three possible sources of licensing information: whether license metadata is present and valid, whether a license can be retrieved through a query, and whether a human-readable license is available and confirmed. The final reusability score is set to 1 if licensing information is available from at least one of these three sources, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algR12 a fairo:CalculationAlgorithm ;
    rdfs:label "R1.2" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It evaluates five possible sources of provenance data: author information obtained through a query, author information from metadata (excluding entries where both name and email are marked as absent), contributor information, publisher information, and source attribution (checking if at least one of name, web address, or email is present). The final score is set to 1 if any of these five provenance indicators contains valid information, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algR13D a fairo:CalculationAlgorithm ;
    rdfs:label "R1.3-D" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It checks two conditions: whether the dataset uses a common media type, and whether the metadata media type includes a recognized semantic format (specifically SPARQL API or RDF). The final score is set to 1 if either the common media type flag is true or a known semantic format is detected, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:algR13M a fairo:CalculationAlgorithm ;
    rdfs:label "R1.3-M" ;
    fairo:implementedBy :KGHeartBeat ;
    fairo:algorithmDescription "It checks two sources for VoID (Vocabulary of Interlinked Datasets) availability: whether a VoID URL exists in the metadata, and whether a VoID or DCAT description can be retrieved by querying the SPARQL endpoint directly. The final interoperability score is set to 1 if a VoID description is available from either source, otherwise it is set to 0." ;
    fairo:appliesScoringFunction :binaryScoringFunction .

:linearCombination a fairo:AggregationMethod ;
    rdfs:label "Linear Combination" ;
    fairo:formula "Score(P) = (1/n) * sum_{i=1..n}(s_i), where s_i in [0,1] and Score(P) in [0,1]. FAIR_Score = sum_{j=1..4}(Score(P_j)), where FAIR_Score in [0,4]." ;
    dct:description "The score of a principle is computed as the arithmetic mean of the scores of its associated sub-principles. Specifically, each sub-principle contributes a value in the range [0,1] and the principle score is obtained by summing all sub-principle scores and dividing by the total number of sub-principles, resulting in a normalized value between 0 and 1. The overall FAIR score is then calculated by aggregating the scores of the four FAIR principles. This aggregation is performed as a simple sum of the individual principle scores, producing a final FAIR score that ranges from 0 to 4." .
